{
  "version": 2,
  "functions": {
    "api/ml.js": {
      "maxDuration": 60
    },
    "api/mcp.js": {
      "maxDuration": 60
    },
    "api/pepito.js": {
      "maxDuration": 60,
      "includeFiles": "public/index.html"
    },
    "api/whatsapp.js": {
      "maxDuration": 60,
      "includeFiles": "public/index.html"
    },
    "api/avisos.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource/:resto*",
      "destination": "/api/mcp?ruta=recurso"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:resto*",
      "destination": "/api/mcp?ruta=servidor"
    },
    {
      "source": "/.well-known/openid-configuration/:resto*",
      "destination": "/api/mcp?ruta=servidor"
    },
    {
      "source": "/oauth/:accion",
      "destination": "/api/mcp?ruta=:accion"
    },
    {
      "source": "/callback",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/avisos",
      "schedule": "0 14 * * *"
    }
  ]
}
