# Archivo de ejemplo: no pongas valores reales aquí (el repositorio es público).
# Los valores reales van en Vercel → Settings → Environment Variables.

# Firebase
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_PRIVATE_KEY=tu-llave-privada-de-firebase
FIREBASE_CLIENT_EMAIL=tu-cuenta-de-servicio@tu-proyecto-firebase.iam.gserviceaccount.com

# Mercado Libre
ML_APP_ID=tu-app-id
ML_SECRET_KEY=tu-secret-de-mercado-libre
